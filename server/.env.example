# Server configuration
PORT=5000
NODE_ENV=development

# Local MongoDB example. Replace with your own MongoDB connection string.
MONGO_URI=mongodb://127.0.0.1:27017/examprep_ai

# Comma-separated frontend origins allowed to call the API.
CLIENT_URL=http://localhost:5173

# Generate a strong random secret (at least 32 bytes) and keep it private.
JWT_SECRET=replace_this_with_a_long_random_secret

# Groq API (keep this key on the backend only).
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
